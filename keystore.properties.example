# 이 파일을 keystore.properties 로 복사해서 실제 값을 채운다.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties 와 *.jks 는 .gitignore 에 걸려 있으니 절대 커밋되지 않는다.
#
# 서명키가 바뀌면 (1) 앱 내 자동 업데이트 설치가 실패하고
#                (2) Android Auto Backup 복원이 실패한다.
# 한 번 만든 키는 절대 잃어버리지 말 것. 별도 백업 필수.

# 키 파일 위치.
# 절대경로를 권한다. 상대경로를 쓰면 이 저장소의 최상위 디렉토리를 기준으로 풀리는데,
# 키는 보통 저장소 바깥에 두므로 몇 단계를 거슬러 올라가야 하는지 헷갈리기 쉽다.
# 예: /Users/이름/dong-budget-release.jks
storeFile=

storePassword=
keyAlias=dong-budget
keyPassword=
