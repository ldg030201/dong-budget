# 이 파일을 keystore.properties 로 복사해서 실제 값을 채운다.
# keystore.properties 와 *.jks 는 .gitignore 에 걸려 있으니 절대 커밋되지 않는다.
#
# 서명키가 바뀌면 (1) 앱 내 자동 업데이트 설치가 실패하고
#                (2) Android Auto Backup 복원이 실패한다.
# 한 번 만든 키는 절대 잃어버리지 말 것. 별도 백업 필수.
storeFile=../dong-budget-release.jks
storePassword=
keyAlias=dong-budget
keyPassword=
