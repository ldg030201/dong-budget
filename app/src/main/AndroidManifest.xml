<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 새 버전을 받는 데 쓰는 권한(인터넷, 설치 허용)은 배포처마다 다르다. 배포처의 AndroidManifest(src/<배포처>)에 둔다. -->

    <!-- 토스·카카오페이 결제 알림을 읽으면 '가계부에 등록할까요?' 알림을 보낸다. Android 13 부터 사용자가 허락해야 한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 재부팅하면 월급날 알람이 사라진다. 켜질 때 다시 맞춘다. 설치할 때 자동으로 주어지는 일반 권한이다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 월급 탭을 지문으로 열 때 쓴다. 설치할 때 자동으로 주어지는 일반 권한이다. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />


    <application
        android:name=".BudgetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.DongBudget">

        <!-- singleTop: 앱이 열린 채로 결제 등록 알림을 누르면 화면을 새로 쌓지 않고 onNewIntent 로 받는다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DongBudget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알림 읽기. 사용자가 기기 설정에서 '알림 읽기' 를 허용해야 시스템이 연결한다.
             시스템만 연결할 수 있게 BIND_NOTIFICATION_LISTENER_SERVICE 권한으로 막는다.
             모든 앱의 알림이 들어오지만 토스·카카오페이 결제 알림만 쓰고 나머지는 바로 버린다.
             시스템은 사용자의 허용을 이 클래스 이름으로 기억한다. 이름이나 패키지 경로를 바꾸면
             업데이트할 때 허용이 조용히 풀리므로 바꾸지 않는다. -->
        <service
            android:name=".data.capture.PaymentNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- 계속 떠 있는 알림(음악, 길 안내, 내려받기 진행률 등)은 받지 않는다. 결제 알림은 이런 알림이 아닌데,
                 이런 알림은 갱신될 때마다 들어와서 버리는 것만으로도 일이 된다. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>

        <!-- 월급날 알람과 재부팅·업데이트를 받는다. 알람은 앱이 직접 보내고, 재부팅·업데이트는 시스템이 보내서
             외부에 열지 않아도 받는다. -->
        <receiver
            android:name=".data.salary.SalaryAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
