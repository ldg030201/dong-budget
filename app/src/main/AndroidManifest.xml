<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 새 버전 확인과 내려받기에만 쓴다. 앱이 가계부 내용을 어디로도 보내지 않는다.
         다만 Android 자동 백업이 켜져 있으면 OS 가 데이터베이스를 사용자의 구글 계정에 백업한다.
         그건 앱이 보내는 것이 아니라 기기 설정에 따른 동작이고 사용자가 끌 수 있다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 내려받은 APK 를 설치 화면까지 띄우기 위해 필요하다.
         실제 설치는 사용자가 시스템 확인창에서 직접 눌러야 진행된다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />


    <application
        android:name=".BudgetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.DongBudget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DongBudget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 받아둔 업데이트 파일을 시스템 설치기로 열 때, 그 파일 하나만 읽을 수 있게 잠깐 빌려준다.
             authorities 뒷부분은 ApkInstaller.AUTHORITY_SUFFIX 와 같아야 한다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_files" />
        </provider>

        <!-- 설치 세션의 진행 상황을 받는다. 앱 내부에서만 쓰므로 외부에 열지 않는다. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
